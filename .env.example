# ===============================================================
# SPACES PLATFORM - ROOT ENVIRONMENT OVERVIEW
# ===============================================================
# Note: Each service maintains its own .env file in its directory:
#   - backend/.env
#   - ai_service/.env
#
# Below are the primary environment variables across both services.
# ===============================================================

# ─── Node.js Backend (backend/.env) ───────────────────────────
NODE_PORT=3000
NODE_ENV=production
DATABASE_URL=file:./dev.db
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=your_internal_shared_secret_service_token
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here_32chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here_32chars

# ─── Razorpay Payments & Webhooks ────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Python AI Service (ai_service/.env) ───────────────────────
OPENAI_API_KEY=your_openai_api_key_here
AI_SERVICE_TOKEN=your_internal_shared_secret_service_token
LLM_MODEL=gpt-4o-mini
DEEP_SEARCH_MODEL=gpt-4o-mini
QUICK_SEARCH_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
BACKEND_CALLBACK_URL=http://127.0.0.1:3000/api/v1/ai/internal/index-complete

