# ─── Server Configuration ──────────────────────────────────────
PORT=3000
NODE_ENV=development
API_VERSION=v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────
# Default SQLite for local zero-dependency development
DATABASE_URL=file:./dev.db

# ─── Authentication (Minimum 32 characters required) ───────────
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here_32chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here_32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# ─── Python AI Service Connection ──────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=your_internal_shared_secret_service_token
AI_TOP_K=8
AI_MAX_CANDIDATES=1000
AI_MIN_SIMILARITY=0.18
AI_MAX_INDEX_FILE_BYTES=25000000

# ─── File Storage & Uploads ────────────────────────────────────
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500

# ─── Razorpay Payments & Webhooks ────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100